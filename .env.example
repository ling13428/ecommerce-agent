# 环境变量模板：可以提交到 Git，供他人复制为 .env
# 复制命令：Copy-Item .env.example .env
LLM_API_KEY=sk-replace-with-your-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_MAX_STEPS=5
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.2

# ===== 备用供应商 + 熔断（可选）=====
# 主供应商连续失败 N 次后，冷却期内改用备用供应商
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_CIRCUIT_FAILURES=3
LLM_CIRCUIT_COOLDOWN=60
# Agent 编排引擎：graph（LangGraph，默认）/ legacy（自研循环，用于回退）
AGENT_ENGINE=graph
# LangGraph 断点持久化：sqlite（Windows 本地）/ postgres（容器/Linux 多实例）/ memory（仅测试）
AGENT_CHECKPOINT_BACKEND=sqlite
AGENT_CHECKPOINT_DB_PATH=data/sessions/checkpoints.db
# 意图路由 L2：规则层不确定时调用 LLM 结构化分类兜底
ROUTER_LLM_ENABLED=true
# L2 结果置信度达到该值才覆盖规则层结果
ROUTER_LLM_MIN_CONFIDENCE=0.7
ROUTER_LLM_TIMEOUT=3
ROUTER_LLM_MAX_TOKENS=200

# ===== Embedding（阿里云百炼 DashScope，OpenAI 兼容接口）=====
# 在百炼控制台创建 API Key 后填入，不要提交到 Git
EMBEDDING_API_KEY=sk-replace-with-your-dashscope-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 控制台里的模型名，例如 text-embedding-v3 / text-embedding-v4
EMBEDDING_MODEL=text-embedding-v3
# 必须与模型的输出维度一致；v3 默认 1024，可配 768/512
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT=30

# ===== OCR（扫描件/图片解析，默认复用 DashScope Key）=====
# 留空则使用 EMBEDDING_API_KEY / EMBEDDING_BASE_URL
OCR_API_KEY=
OCR_BASE_URL=
OCR_MODEL=qwen-vl-ocr
OCR_TIMEOUT=60

# ===== 鉴权 =====
# 商家工作台调用 /api/admin/* 需要携带 X-Admin-Token
ADMIN_TOKEN=replace-with-a-long-random-admin-token
# 买家登录 Token 的 HMAC 签名密钥，必须稳定且不可泄露
AUTH_SECRET=replace-with-a-long-random-auth-secret
# 买家 Token 有效期（小时）
BUYER_TOKEN_TTL_HOURS=24
# ===== 买家登录（手机号 + 验证码）=====
# console：验证码打印到日志；接入真实短信网关后替换
SMS_PROVIDER=console
# 仅本地演示：在发送接口返回 debug_code，生产必须为 false
SMS_DEBUG=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_SEND_COOLDOWN=60

# ===== Redis（热状态：会话 / 限流 / 幂等键）=====
# memory：单进程本地演示；redis：多 worker / 多实例共享
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# 每个事件循环的异步 Redis 连接池上限
REDIS_MAX_CONNECTIONS=100
# 会话在 Redis 中的 TTL（秒）
SESSION_TTL_SECONDS=604800

# ===== 工具层：Agent 内进程 or 内部 MCP server =====
# local：工具直接在当前进程执行（默认，最省事）
# mcp：commerce / catalog / knowledge 三类工具走内部 MCP server
TOOL_BACKEND=local
# 工具上下文与写操作审批令牌的 HMAC 密钥；留空时回退 AUTH_SECRET
TOOL_SECRET=
TOOL_CONTEXT_TTL_SECONDS=300
TOOL_APPROVAL_TTL_SECONDS=300
MCP_TIMEOUT=10
# 内部 MCP server 地址（streamable HTTP，路径固定 /mcp）
MCP_COMMERCE_URL=http://127.0.0.1:9101/mcp
MCP_CATALOG_URL=http://127.0.0.1:9102/mcp
MCP_KNOWLEDGE_URL=http://127.0.0.1:9103/mcp
# ===== 工具执行硬化 =====
# 单次工具执行超时（秒）；ToolSpec.timeout 可覆盖
TOOL_TIMEOUT=15
# 本地工具专用线程池与每工具并发上限，避免慢工具耗尽默认线程池
TOOL_MAX_WORKERS=16
TOOL_MAX_CONCURRENCY_PER_TOOL=8
# 只读工具最多尝试次数（写操作永远只执行一次）与指数退避基数（秒）
TOOL_RETRY_ATTEMPTS=2
TOOL_RETRY_BACKOFF=0.2
# 工具级熔断：连续失败次数与冷却时间（秒）
TOOL_CIRCUIT_FAILURES=5
TOOL_CIRCUIT_COOLDOWN=30
# 工具返回体大小预算（字符）；超出后按字符串/列表粒度截断
TOOL_RESULT_MAX_CHARS=24000
TOOL_RESULT_STRING_MAX_CHARS=4000
TOOL_RESULT_LIST_MAX_ITEMS=50
# 写操作幂等：结果保留时长、不确定结果保留时长、内存兜底条数、锁 TTL
TOOL_IDEMPOTENCY_TTL_SECONDS=86400
TOOL_IDEMPOTENCY_UNCERTAIN_TTL_SECONDS=300
TOOL_IDEMPOTENCY_MAX_ENTRIES=5000
TOOL_IDEMPOTENCY_LOCK_TTL_SECONDS=60

# ===== PostgreSQL + pgvector（docker compose 映射到本机 5433）=====
DATABASE_URL=postgresql://rag:rag@localhost:5433/ecommerce_rag
# 订单/售后业务数据后端：sqlite（本地回退）/ postgres（推荐）
ORDERS_BACKEND=sqlite

# ===== 商品真实数据源（M6）=====
# mock：本地 catalog.json；saleor：通过 GraphQL 调真实电商后端
PRODUCT_PROVIDER=mock
# 订单数据源：mock（本地库）/ saleor（GraphQL 只读）
ORDER_PROVIDER=mock
# 灰度：0-100 按买家哈希放量；ALLOWLIST 非空时只放行名单内买家
SALEOR_ROLLOUT_PERCENT=100
SALEOR_ALLOWLIST=
SALEOR_API_URL=http://127.0.0.1:8001/graphql/
SALEOR_CHANNEL=emberfox
SALEOR_TOKEN=
SALEOR_EMAIL=admin@example.com
SALEOR_PASSWORD=
SALEOR_TIMEOUT=5
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_TIMEOUT=5
# 订单/审计运行时异步连接池（Postgres）
DATABASE_ASYNC_POOL_MIN_SIZE=1
DATABASE_ASYNC_POOL_MAX_SIZE=20
DATABASE_ASYNC_POOL_TIMEOUT=5
# SQLite / Windows Proactor 回退时的专用线程池
ORDERS_WORKERS=4
AUDIT_WORKERS=2
# 知识库低分拒答阈值（余弦相似度），低于该值转人工
RAG_MIN_SCORE=0.55

# ===== 混合检索（BM25 + 稠密向量 + RRF + CrossEncoder rerank）=====
# BM25 为内置纯 Python 实现，无额外依赖；jieba 可选（未装则中文按二元组切分）
# CrossEncoder rerank 需要：pip install sentence-transformers（会带入 torch）
# 国内下载模型可先设置 HF_ENDPOINT=https://hf-mirror.com，并加 HF_HUB_DISABLE_XET=1
# 模型也可提前下载到本地，然后把 RERANK_MODEL 指向该目录
RAG_HYBRID_ENABLED=true
# 稀疏路候选子块数
RAG_SPARSE_CANDIDATES=40
# RRF 平滑参数，常用 60
RAG_RRF_K=60
# BM25 内存索引缓存秒数，0 表示不缓存（每次重建）
RAG_BM25_INDEX_TTL=300

# 实测 bge-reranker-base 在 CPU 上拖慢且降召回，默认关闭
RERANK_ENABLED=false
# CrossEncoder 模型；首次使用会从 HuggingFace 下载
RERANK_MODEL=BAAI/bge-reranker-base
# cpu / cuda
RERANK_DEVICE=cpu
# 进入 rerank 的父块数量
RERANK_TOP_N=20
RERANK_BATCH_SIZE=8
# 送入 CrossEncoder 的文本字符上限（模型本身还会按 512 token 截断）
RERANK_MAX_CHARS=1500

# ===== 会话与运行轨迹持久化 =====
# 关闭后只保留内存会话，重启即丢失
SESSION_PERSISTENCE=true
SESSION_DB_PATH=data/sessions/sessions.db
# 会话/消息/trace 的持久后端：sqlite（本地）/ postgres（推荐，多实例）
SESSION_STORE_BACKEND=sqlite
# normalized：消息/trace 增量追加 + 版本号 CAS（推荐）
# payload：旧版整包 JSON 覆盖（仅用于回滚）
SESSION_STORAGE_MODE=normalized
# Postgres 会话保留天数（配合 scripts/prune_sessions.py）
SESSION_RETENTION_DAYS=30
# 会话异步连接池（Postgres）：独立于订单/审计的同步连接池
SESSION_DB_POOL_MIN_SIZE=1
SESSION_DB_POOL_MAX_SIZE=20
SESSION_DB_POOL_TIMEOUT=5
# SQLite 会话仓库专用线程池大小（本地/回退）
SESSION_SQLITE_WORKERS=4
# 空闲超过该分钟数，下一次消息自动开新会话
SESSION_IDLE_TIMEOUT_MINUTES=30
# 同一会话并发写入锁：等待超时 / 锁 TTL（秒）
SESSION_LOCK_TIMEOUT_SECONDS=5
SESSION_LOCK_TTL_SECONDS=60
# 版本号不符时严格拒绝写入
SESSION_VERSION_STRICT=true

# 日志格式：text（本地）/ json（容器/采集）
LOG_FORMAT=text
# 操作审计落库开关（测试环境可设 false）
AUDIT_ENABLED=true
# 告警 Webhook（可选），为空时只写 ERROR 日志
ALERT_WEBHOOK_URL=
# SSE 心跳间隔（秒），0 表示关闭
SSE_HEARTBEAT_SECONDS=15
RATE_LIMIT_PER_MINUTE=20
MAX_MESSAGE_CHARS=2000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
